@startuml
skinparam dpi 150
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 30
skinparam ranksep 50
left to right direction

actor "Étudiant" as E
actor "Responsable\npédagogique" as R
actor "Administrateur" as A

rectangle "Application de gestion des stages" {
  usecase "Soumettre une\ndemande de stage" as UC1
  usecase "Consulter l'état de\nses demandes" as UC2
  usecase "Valider ou refuser\nune demande" as UC3
  usecase "Affecter un\nencadreur" as UC4
  usecase "Rechercher\nun dossier" as UC5
  usecase "Gérer les comptes\net les rôles" as UC6
}

E --> UC1
E --> UC2
R --> UC3
R --> UC4
R --> UC5
A --> UC6
@enduml
